{
    "name": "learn-electron-vue3",
    "version": "0.1.0",
    "private": true,
    "main": "electron-main.js",
    "scripts": {
        "dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && electron .\"",
        "dev:vite": "vite",
        "test:e2e": "playwright test",
        "test:e2e:report": "playwright show-report",
        "start": "electron .",
        "build": "vite build && electron-builder"
    },
    "dependencies": {
        "vue": "^3.4.0",
        "vue-router": "^4.3.0"
    },
    "devDependencies": {
        "@playwright/test": "^1.60.0",
        "@vitejs/plugin-vue": "^4.3.0",
        "concurrently": "^8.2.0",
        "electron": "^26.0.0",
        "electron-builder": "^24.6.0",
        "playwright": "^1.60.0",
        "typescript": "^5.6.0",
        "vite": "^5.4.0",
        "wait-on": "^7.0.1"
    },
    "build": {
        "appId": "com.example.learn-electron-vue3",
        "files": [
            "**/*"
        ],
        "directories": {
            "output": "dist"
        }
    }
}
